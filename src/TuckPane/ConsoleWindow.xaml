                            <BrushTransition Duration="0:0:0.12"/>
                        </Border.BackgroundTransition>
                        <FontIcon FontSize="10" Glyph="&#xE921;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
