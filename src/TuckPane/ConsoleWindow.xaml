                            <Border Background="{StaticResource ConsoleCardSurfaceBrush}" BorderBrush="#14000000" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListView x:Name="ManageList" Padding="4,6" SelectionChanged="ManageList_SelectionChanged">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Background" Value="{StaticResource ListViewItemBackground}"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Margin" Value="2,1"/>
                                                <Setter Property="MinHeight" Value="46"/>
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Resources>
                                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorDisabledBrush" Color="Transparent"/>
                                        </ListView.Resources>
                                    </ListView>
                                    <StackPanel x:Name="ManageEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12" Visibility="Collapsed">
                                        <TextBlock Tag="loc:ManageCategoryEmpty" Text="此类别还没有窗口" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" BorderBrush="{StaticResource ConsoleGeneralRowBorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                                        <Button x:Name="ManageAddButton" MinHeight="34" Height="34" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="BeginCreationButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon FontSize="12" Glyph="&#xE710;"/>
                                                <TextBlock FontSize="13" FontWeight="Medium" Tag="loc:Create" Text="创建"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border x:Name="ManageDetailCard" Grid.Column="1" Padding="0" Background="Transparent" CornerRadius="12">
                                <Grid x:Name="ManageEditor">
                                    <ScrollViewer Padding="0,0,10,20" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                                            <InfoBar x:Name="MissingStorageInfo" IsOpen="False" IsClosable="False" Severity="Warning" Title="实际目录不存在"/>
                                            <local:OrganizerSettingsForm x:Name="ManageForm" IsCreationMode="False"/>
                                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="RecreateStorageButton" Click="RecreateStorageButton_Click" Content="重建目录" Tag="loc:RecreateStorage" Visibility="Collapsed"/>
                                                <Button x:Name="DeleteOrganizerButton" Click="DeleteOrganizerButton_Click" Content="删除收纳窗" Tag="loc:DeleteOrganizer" Background="{StaticResource ConsoleCardSurfaceBrush}" Foreground="#FFC42B1C" BorderBrush="#40C42B1C" BorderThickness="1">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14C42B1C"/>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24C42B1C"/>
                                                        <SolidColorBrush x:Key="ButtonForeground" Color="#C42B1C"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#B02316"/>
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#991D12"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#40C42B1C"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#70C42B1C"/>
                                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#90C42B1C"/>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border x:Name="AddEditor" Grid.Column="1" Background="Transparent" Visibility="Collapsed">
                                <ScrollViewer x:Name="CreationScrollViewer" Padding="0,0,10,20" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                    <StackPanel x:Name="AddSettingsColumn" HorizontalAlignment="Stretch" Spacing="14">
                                        <local:OrganizerSettingsForm x:Name="AddForm" IsCreationMode="True"/>
                                        <StackPanel Margin="0,2,0,0" Spacing="6">
                                            <Button x:Name="CreateOrganizerButton" HorizontalAlignment="Left" MinWidth="104" Click="CreateOrganizerButton_Click" Content="创建" Tag="loc:Create" Background="{StaticResource ConsoleSelectionAccentBrush}" Foreground="#FFFFFF" BorderThickness="0">
                                                <Button.Resources>
                                                    <SolidColorBrush x:Key="ButtonBackground" Color="#007AFF"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#006EE6"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0062CC"/>
                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#D1D1D6"/>
                                                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock x:Name="CreateLimitText" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{StaticResource ConsoleSecondaryTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
        <Grid x:Name="SettingsEdgeOverlay" Grid.RowSpan="2" Background="Transparent" Canvas.ZIndex="100" IsHitTestVisible="False"/>
    </Grid>
</Window>
