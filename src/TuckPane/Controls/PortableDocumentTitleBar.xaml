<UserControl
    x:Class="TuckPane.PortableDocumentTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="DragTitleBarRoot" Padding="14,0,6,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid
            x:Name="TitleDragSurfaceElement"
            Grid.Column="0"
            Background="Transparent" />
        <TextBlock
            x:Name="TitleTextElement"
            Grid.Column="0"
            HorizontalAlignment="Left"
            Margin="0,0,48,0"
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Text"
            FontSize="15"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" />
        <TextBox
            x:Name="TitleEditorElement"
            Grid.Column="0"
            MinWidth="100"
            Margin="-4,1,8,1"
            MinHeight="0"
            Padding="4,0"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="1"
            FontFamily="Segoe UI Variable Text"
            FontSize="15"
            FontWeight="SemiBold"
            Visibility="Collapsed" />
        <Button
            x:Name="ColorButtonElement"
            Grid.Column="1"
            Width="20.4"
            Height="20.4"
            MinWidth="0"
            MinHeight="0"
            Margin="0,0,2,0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            HorizontalContentAlignment="Center"
            Padding="0"
            VerticalContentAlignment="Center">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="9.6" Glyph="&#xE790;" />
        </Button>
        <ToggleButton
            x:Name="OptionToggleButtonElement"
            Grid.Column="2"
            Width="20.4"
            Height="20.4"
            MinWidth="0"
            MinHeight="0"
            Margin="0,0,2,0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            HorizontalContentAlignment="Center"
            Padding="0"
            VerticalContentAlignment="Center">
            <Viewbox Width="12" Height="12">
                <SymbolIcon Symbol="Bullets" />
            </Viewbox>
        </ToggleButton>
        <Button
            x:Name="CloseButtonElement"
            Grid.Column="3"
            Width="20.4"
            Height="20.4"
            MinWidth="0"
            MinHeight="0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="8"
            HorizontalContentAlignment="Center"
            Padding="0"
            VerticalContentAlignment="Center">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="8.4" Glyph="&#xE711;" />
        </Button>
    </Grid>
</UserControl>
