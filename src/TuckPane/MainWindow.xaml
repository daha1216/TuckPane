<Window
    x:Class="TuckPane.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TuckPane.Controls">

    <Grid
        x:Name="WindowRoot"
        AllowDrop="True"
        Background="Transparent"
        UseLayoutRounding="True"
        DragEnter="WindowRoot_DragEnter"
        DragLeave="WindowRoot_DragLeave"
        DragOver="WindowRoot_DragOver"
        Drop="WindowRoot_Drop"
        KeyDown="WindowRoot_KeyDown">

        <Grid.Resources>
            <Style x:Key="OrganizerMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
                <Setter Property="HighContrastAdjustment" Value="Auto" />
                <Setter Property="RequestedTheme" Value="Light" />
                <Setter Property="SystemBackdrop" Value="{x:Null}" />
                <Setter Property="Background" Value="#FFFFFFFF" />
            </Style>
            <Style x:Key="OrganizerHideNameMenuStyle" TargetType="ToggleMenuFlyoutItem"
                   BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleMenuFlyoutItem">
                            <Grid x:Name="LayoutRoot" Padding="{TemplateBinding Padding}"
                                  Margin="{StaticResource MenuFlyoutItemMargin}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPointerOver}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundPressed}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Background" Value="{ThemeResource MenuFlyoutItemBackgroundDisabled}" />
                                                <Setter Target="TextBlock.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                                <Setter Target="CheckGlyph.Foreground" Value="{ThemeResource MenuFlyoutItemForegroundDisabled}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckGlyph.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="PaddingSizeStates">
                                        <VisualState x:Name="DefaultPadding" />
                                        <VisualState x:Name="NarrowPadding">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Padding" Value="{StaticResource MenuFlyoutItemThemePaddingNarrow}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TextBlock" Text="{TemplateBinding Text}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="{ThemeResource MenuFlyoutItemTextTrimming}"
                                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <FontIcon x:Name="CheckGlyph" Grid.Column="1" Width="16" Margin="16,0,0,0"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE73E;"
                                          FontSize="12" Foreground="{TemplateBinding Foreground}" Opacity="0"
                                          VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <MenuFlyout
                x:Name="OrganizerContextMenu"
                Closed="ContextMenu_Closed"
                MenuFlyoutPresenterStyle="{StaticResource OrganizerMenuPresenterStyle}"
                Opened="ContextMenu_Opened"
                Opening="ContextMenu_Opening"
                ShouldConstrainToRootBounds="False">
                <MenuFlyoutSubItem x:Name="AddItemMenuItem" Tag="ContextAddItem" Text="添加项目">
                    <MenuFlyoutItem Click="AddFileMenuItem_Click" Tag="ContextAddFile" Text="文件…" />
                    <MenuFlyoutItem Click="AddFolderMenuItem_Click" Tag="ContextAddFolder" Text="文件夹…" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="NewFolderMenuItem" Click="NewFolderMenuItem_Click" Tag="ContextNewFolder" Text="新建文件夹" />
                <MenuFlyoutItem x:Name="NewNoteMenuItem" Click="NewNoteMenuItem_Click" Tag="ContextNewNote" Text="新建便签" />
                <MenuFlyoutItem x:Name="NewTodoMenuItem" Click="NewTodoMenuItem_Click" Tag="ContextNewTodo" Text="新建待办" />
                <MenuFlyoutItem x:Name="PasteMenuItem" Click="PasteMenuItem_Click" IsEnabled="False" Tag="ContextPaste" Text="粘贴" />
                <MenuFlyoutItem x:Name="DeleteWindowMenuItem" Click="DeleteWindowMenuItem_Click" Tag="ContextDeleteWindow" Text="删除" />
                <MenuFlyoutItem x:Name="OpenStorageMenuItem" Click="OpenStorageMenuItem_Click" Tag="ContextOpenStorage" Text="打开收纳目录" />
                <MenuFlyoutItem x:Name="RenameMenuItem" Click="RenameMenuItem_Click" Tag="ContextRename" Text="重命名" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ManageMenuItem" Click="ManageMenuItem_Click" Tag="ContextManage" Text="设置" />
                <MenuFlyoutItem x:Name="DuplicateMenuItem" Click="DuplicateWindowMenuItem_Click" Tag="ContextDuplicate" Text="窗口复制" />
                <MenuFlyoutItem x:Name="ToggleModeMenuItem" Tag="ContextSwitchPlacement" Click="ToggleModeMenuItem_Click" Text="改为定位" />
                <MenuFlyoutItem x:Name="ToggleContentModeMenuItem" Tag="ContextSwitchContent" Click="ToggleContentModeMenuItem_Click" Text="改为精简" />
                <MenuFlyoutItem x:Name="ToggleExpansionModeMenuItem" Tag="ContextSwitchExpansion" Click="ToggleExpansionModeMenuItem_Click" Text="改为展开" />
                <ToggleMenuFlyoutItem x:Name="HideNameMenuItem" Tag="ContextHideName" Style="{StaticResource OrganizerHideNameMenuStyle}" Click="HideNameMenuItem_Click" Text="隐藏名称" />
                <MenuFlyoutSubItem x:Name="SortMenuItem" Tag="ContextSort" Text="排序方式">
                    <MenuFlyoutItem x:Name="SortByNameAscMenuItem" Click="SortByNameAscMenuItem_Click" Tag="ContextSortNameAsc" Text="按名称（A→Z）" />
                    <MenuFlyoutItem x:Name="SortByNameDescMenuItem" Click="SortByNameDescMenuItem_Click" Tag="ContextSortNameDesc" Text="按名称（Z→A）" />
                    <MenuFlyoutItem x:Name="SortByTypeMenuItem" Click="SortByTypeMenuItem_Click" Tag="ContextSortType" Text="按类型" />
                    <MenuFlyoutItem x:Name="SortByDateModifiedMenuItem" Click="SortByDateModifiedMenuItem_Click" Tag="ContextSortDateModified" Text="按修改日期" />
                    <MenuFlyoutItem x:Name="SortBySizeMenuItem" Click="SortBySizeMenuItem_Click" Tag="ContextSortSize" Text="按大小" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="TidyEdgeStackMenuItem" Tag="ContextTidyEdgeStack" Click="TidyEdgeStackMenuItem_Click" Text="整齐贴边排列" />
                <MenuFlyoutItem x:Name="AlignToDesktopGridMenuItem" Tag="ContextAlignToDesktopGrid" Click="AlignToDesktopGridMenuItem_Click" Text="对齐桌面图标网格" />
                <MenuFlyoutItem x:Name="ImportDesktopSelectionMenuItem" Tag="ContextImportDesktopSelection" Click="ImportDesktopSelectionMenuItem_Click" Text="收入桌面已选项目" />
                <MenuFlyoutItem x:Name="CompactGridGapsMenuItem" Tag="ContextCompactGridGaps" Click="CompactGridGapsMenuItem_Click" Text="紧凑排布空位" />
            </MenuFlyout>
        </Grid.Resources>

        <Grid
            x:Name="CompactView"
            ContextRequested="OrganizerWindow_ContextRequested"
            Width="76"
            Height="68"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="39" />
                <RowDefinition Height="4" />
                <RowDefinition Height="23" />
            </Grid.RowDefinitions>
            <Border
                x:Name="CompactNativeSelectionPlate"
                Grid.RowSpan="3"
                Margin="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="14"
                BorderThickness="1"
                Background="Transparent"
                BorderBrush="Transparent"
                IsHitTestVisible="False">
                <Border.BackgroundTransition>
                    <BrushTransition Duration="0:0:0.13" />
                </Border.BackgroundTransition>
            </Border>
            <Grid
                x:Name="CompactTile"
                Grid.Row="0"
                Width="39"
                Height="39"
                HorizontalAlignment="Center"
                Background="Transparent"
                PointerEntered="CompactTile_PointerEntered"
                PointerExited="CompactTile_PointerExited"
                PointerCanceled="CompactTile_PointerCanceled"
                PointerCaptureLost="CompactTile_PointerCaptureLost"
                PointerMoved="CompactTile_PointerMoved"
                PointerPressed="CompactTile_PointerPressed"
                PointerReleased="CompactTile_PointerReleased">
                <Border
                    x:Name="CompactFolderTab"
                    Width="20"
                    Height="7"
                    Margin="4,-4,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    CornerRadius="4,4,1,0"
                    BorderThickness="1,1,1,0"
                    BorderBrush="#90FFFFFF"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E8F8D872" Offset="0" />
                            <GradientStop Color="#DDE7B742" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid
                    x:Name="CompactShadowHost"
                    Width="39"
                    Height="39"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
                <Grid
                    x:Name="CompactThumbnailHost"
                    Width="39"
                    Height="39"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <SystemBackdropElement x:Name="CompactSurfaceHost" IsHitTestVisible="False" />
                    <Border
                        x:Name="CompactLiquidSheen"
                        CornerRadius="14"
                        BorderThickness="0.75"
                        IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#B4FFFFFF" Offset="0" />
                                <GradientStop Color="#14000000" Offset="0.48" />
                                <GradientStop Color="#22000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3AFFFFFF" Offset="0" />
                                <GradientStop Color="#10FFFFFF" Offset="0.34" />
                                <GradientStop Color="#00FFFFFF" Offset="0.68" />
                                <GradientStop Color="#18FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border
                            x:Name="CompactLiquidInnerRim"
                            CornerRadius="13"
                            BorderThickness="0.75"
                            IsHitTestVisible="False">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E2FFFFFF" Offset="0" />
                                    <GradientStop Color="#10FFFFFF" Offset="0.46" />
                                    <GradientStop Color="#5CFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>
                    </Border>
                    <Border
                        x:Name="CompactNativeBadge"
                        CornerRadius="14"
                        BorderThickness="1"
                        BorderBrush="#1E000000"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#20FFFFFF" Offset="0" />
                                <GradientStop Color="#0EFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border
                            x:Name="CompactNativeInnerRim"
                            CornerRadius="13"
                            BorderThickness="1"
                            BorderBrush="#3CFFFFFF"
                            IsHitTestVisible="False" />
                    </Border>
                    <Border
                        x:Name="CompactFolderPocket"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#88FFFFFF"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#58FCE598" Offset="0" />
                                <GradientStop Color="#42EAB949" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="CompactIconPresenter">
                        <Grid x:Name="CompactPreviewGrid" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Image x:Name="CompactPreviewImage0" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview0" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <Image x:Name="CompactPreviewImage1" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview1" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0">
                                <Image x:Name="CompactPreviewImage2" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview2" Visibility="Collapsed" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Image x:Name="CompactPreviewImage3" Stretch="Uniform" />
                                <controls:OrganizerPreviewControl x:Name="CompactOrganizerPreview3" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <FontIcon
                            x:Name="CompactEmptyGlyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="#96FFFFFF"
                            Glyph="&#xE8B7;"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid
                        x:Name="CompactSpecularOverlay"
                        Background="Transparent"
                        Canvas.ZIndex="90"
                        IsHitTestVisible="False" />
                    <Grid
                        x:Name="CompactEdgeOverlay"
                        Background="Transparent"
                        Canvas.ZIndex="100"
                        IsHitTestVisible="False" />
                </Grid>
                <Border
                    x:Name="CompactWarningBadge"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#B81D232B"
                    CornerRadius="11"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="CompactWarningIcon"
                        FontSize="14"
                        Foreground="#FFFFC857"
                        Glyph="&#xE814;" />
                </Border>
                <Border
                    x:Name="CompactMultiSelectBadge"
                    Canvas.ZIndex="110"
                    Width="16"
                    Height="16"
                    Margin="0,2,2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#FF0078D4"
                    BorderBrush="#F2FFFFFF"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="9"
                        FontWeight="Bold"
                        Foreground="White"
                        Glyph="&#xE73E;" />
                </Border>
            </Grid>
            <Grid x:Name="CompactNameContainer" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid
                    x:Name="CompactNameShadowHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False" />
                <TextBlock
                    x:Name="CompactNameShadow1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="CompactNameShadow2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="CompactNameText"
                    MaxWidth="72"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontFamily="Microsoft YaHei UI, Segoe UI Variable Text"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="White"
                    IsTextSelectionEnabled="False"
                    Text="文件夹"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Grid>

        <Grid
            x:Name="ExpandedView"
            ContextRequested="OrganizerWindow_ContextRequested"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Opacity="0"
            UseLayoutRounding="True"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ExpandedTitleRow" Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="ExpandedNameShadowHost"
                Grid.Row="0"
                Margin="16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
            <TextBlock
                x:Name="ExpandedNameText"
                Grid.Row="0"
                Margin="16,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ExpandedOrganizerName"
                FontFamily="Microsoft YaHei UI, Segoe UI Variable Display"
                FontSize="42"
                FontWeight="SemiBold"
                Foreground="White"
                IsHitTestVisible="True"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBox x:Name="ExpandedNameEditor" Grid.Row="0" Margin="16,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="0" MinWidth="0" MinHeight="0"
                TextAlignment="Center" FontFamily="Microsoft YaHei UI, Segoe UI Variable Display" FontWeight="SemiBold"
                Visibility="Collapsed" AutomationProperties.Name="重命名"
                KeyDown="ExpandedNameEditor_KeyDown" LostFocus="ExpandedNameEditor_LostFocus">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="ContentElement"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                            IsHorizontalRailEnabled="False" IsVerticalRailEnabled="False"
                            ZoomMode="Disabled" IsTabStop="False"
                            AutomationProperties.AccessibilityView="Raw" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
            <Grid x:Name="ExpandedPanel" Grid.Row="1">
                <SystemBackdropElement x:Name="ExpandedSurfaceHost" IsHitTestVisible="False" />
                <Border
                    x:Name="ExpandedLiquidSheen"
                    CornerRadius="36"
                    BorderThickness="0.75"
                    IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A8FFFFFF" Offset="0" />
                            <GradientStop Color="#12000000" Offset="0.48" />
                            <GradientStop Color="#1E000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#26FFFFFF" Offset="0" />
                            <GradientStop Color="#0CFFFFFF" Offset="0.36" />
                            <GradientStop Color="#00FFFFFF" Offset="0.70" />
                            <GradientStop Color="#14FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border
                        x:Name="ExpandedLiquidInnerRim"
                        CornerRadius="35"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#DCFFFFFF" Offset="0" />
                                <GradientStop Color="#14FFFFFF" Offset="0.48" />
                                <GradientStop Color="#54FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                    </Border>
                </Border>
                <Grid x:Name="ExpandedContentLayer" Background="Transparent">
                <Border
                    x:Name="SelectionCountBadge"
                    Canvas.ZIndex="4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="14,10,0,0"
                    Padding="10,3,6,3"
                    CornerRadius="12"
                    Background="#CC0067C0"
                    BorderThickness="1"
                    BorderBrush="#66FFFFFF"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="SelectionCountBadgeText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="SelectionClearButton"
                            Width="18"
                            Height="18"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SelectionClearButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Border>
                <Border
                    x:Name="ExpandedFilterBar"
                    Canvas.ZIndex="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="20,6,48,0"
                    Padding="10,2,6,2"
                    MinWidth="220"
                    MaxWidth="360"
                    CornerRadius="14"
                    Background="#CC1F242D"
                    BorderThickness="1"
                    BorderBrush="#33FFFFFF"
                    Visibility="Collapsed">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlForeground" Color="White" />
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="White" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#99FFFFFF" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#B3FFFFFF" />
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#99FFFFFF" />
                    </Border.Resources>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="12" Foreground="White" Opacity="0.8" VerticalAlignment="Center" />
                        <TextBox
                            x:Name="ExpandedFilterBox"
                            Grid.Column="1"
                            MinWidth="120"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="White"
                            FontSize="12"
                            Padding="2,4"
                            TextChanged="ExpandedFilterBox_TextChanged"
                            KeyDown="ExpandedFilterBox_KeyDown"
                            LostFocus="ExpandedFilterBox_LostFocus" />
                        <TextBlock
                            x:Name="ExpandedFilterCountText"
                            Grid.Column="2"
                            FontSize="11"
                            Foreground="White"
                            Opacity="0.7"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="ExpandedFilterClearButton"
                            Grid.Column="3"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ExpandedFilterClearButton_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
                <Button
                x:Name="CollapseButton"
                Width="28"
                Height="28"
                Margin="0,10,14,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Click="CollapseButton_Click"
                PointerCanceled="CollapseButton_PointerReleased"
                PointerEntered="CollapseButton_PointerEntered"
                PointerExited="CollapseButton_PointerExited"
                PointerPressed="CollapseButton_PointerPressed"
                PointerReleased="CollapseButton_PointerReleased"
                AutomationProperties.Name="收缩"
                Canvas.ZIndex="2">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Border
                    x:Name="CollapseButtonSurface"
                    Width="28"
                    Height="28"
                    Background="Transparent"
                    CornerRadius="14">
                    <Border.BackgroundTransition>
                        <BrushTransition Duration="0:0:0.12" />
                    </Border.BackgroundTransition>
                    <Border
                        x:Name="CollapseDash"
                        Width="12"
                        Height="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="0.5"
                        Opacity="0.78">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Border.OpacityTransition>
                        <Border.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.12" />
                        </Border.ScaleTransition>
                    </Border>
                </Border>
                </Button>
                <ScrollView
                x:Name="ItemsScrollView"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Disabled"
                SizeChanged="ItemsScrollView_SizeChanged"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <Grid x:Name="ItemsScrollHost" Background="Transparent">
                <Canvas
                    x:Name="FreeGridOverlayCanvas"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False">
                    <Border
                        x:Name="FreeGridDropSlotGhost"
                        Canvas.ZIndex="10"
                        CornerRadius="16"
                        BorderThickness="1.5"
                        Background="#26FFFFFF"
                        BorderBrush="#90FFFFFF"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="FreeGridDragStackBadge"
                        Canvas.ZIndex="20"
                        MinWidth="24"
                        Height="24"
                        Padding="7,0"
                        CornerRadius="12"
                        Background="#E60078D4"
                        BorderThickness="1.5"
                        BorderBrush="#CCFFFFFF"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="FreeGridDragStackBadgeText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White" />
                    </Border>
                </Canvas>
                <ItemsRepeater
                    x:Name="ItemsRepeater"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AllowDrop="True"
                    Background="Transparent"
                    Margin="28,40.5,28,28"
                    DragEnter="ItemsGrid_DragEnter"
                    DragLeave="ItemsGrid_DragLeave"
                    DragOver="ItemsGrid_DragOver"
                    Drop="ItemsGrid_Drop"
                    ElementClearing="ItemsRepeater_ElementClearing"
                    ElementPrepared="ItemsRepeater_ElementPrepared">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ItemHost"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                ContextRequested="Item_ContextRequested"
                                CornerRadius="16"
                                DoubleTapped="ItemHost_DoubleTapped"
                                Padding="5"
                                PointerCanceled="Item_PointerCanceled"
                                PointerEntered="Item_PointerEntered"
                                PointerExited="Item_PointerExited"
                                PointerCaptureLost="Item_PointerCaptureLost"
                                PointerMoved="Item_PointerMoved"
                                PointerPressed="Item_PointerPressed"
                                PointerReleased="Item_PointerReleased"
                                Tag="{Binding RelativeName}">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.12" />
                                </Border.BackgroundTransition>
                                <StackPanel
                                    x:Name="ItemContent"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    Tag="{Binding RelativeName}"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                                    <Grid x:Name="ItemIconContainer" Width="72" Height="72">
                                        <FontIcon
                                            x:Name="ItemFallbackIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="42"
                                            Glyph="&#xE7C3;"
                                            Visibility="Collapsed" />
                                        <Image
                                            x:Name="ItemImage"
                                            Width="72"
                                            Height="72"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform" />
                                        <controls:OrganizerPreviewControl
                                            x:Name="OrganizerPreview"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <Grid
                                        x:Name="ItemNameContainer"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                        <Grid
                                            x:Name="ItemNameShadowHost"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False" />
                                        <TextBlock
                                            x:Name="ItemNameText"
                                            MaxWidth="132"
                                            FontFamily="Microsoft YaHei UI, Segoe UI Variable Text"
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="White"
                                            IsHitTestVisible="False"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </Grid>
                </ScrollView>
                <Button x:Name="DockEmptyAddButton" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="0" Click="AddItemMenuItem_Click"
                    AutomationProperties.Name="Add item">
                    <FontIcon x:Name="DockEmptyAddIcon" Glyph="&#xE710;" />
                </Button>
                <Canvas
                    x:Name="MarqueeSelectionCanvas"
                    Canvas.ZIndex="90"
                    IsHitTestVisible="False">
                    <Border
                        x:Name="MarqueeSelectionRect"
                        Background="#380078D4"
                        BorderBrush="#E00078D4"
                        BorderThickness="1"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                </Canvas>
                </Grid>
                <Grid
                    x:Name="ExpandedSpecularSweep"
                    Background="Transparent"
                    Canvas.ZIndex="95"
                    IsHitTestVisible="False" />
                <Grid
                    x:Name="ExpandedEdgeOverlay"
                    Background="Transparent"
                    Canvas.ZIndex="100"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
