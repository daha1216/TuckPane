<Window
    x:Class="TuckPane.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TuckPane">
    <Border
        x:Name="WindowFrame"
        BorderThickness="1"
        CornerRadius="8">
        <Grid x:Name="WindowRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:PortableDocumentTitleBar
                x:Name="HeaderBar"
                Grid.Row="0" />

            <WebView2
                x:Name="Editor"
                Grid.Row="1" />

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Border>
</Window>
